## Controllers — One Job Only

```ts
// controllers/worker.controller.ts
// Controller only: validate input → call service → send response
// No DB calls, no business logic, no if/else chains

export async function createProfile(req: Request, res: Response) {
  const body = createProfileSchema.parse(req.body)  // throws if invalid
  const profile = await workerService.createProfile(req.user.id, body)
  return res.status(201).json(success(profile, 'Profile created'))
}
```

---

## Services — Business Logic Only

```ts
// services/worker.service.ts
// Service only: orchestrate, validate business rules, call repositories
// No req/res objects, no HTTP status codes

export async function createProfile(userId: string, data: CreateProfileData) {
  const existing = await workerRepo.findByUserId(userId)
  if (existing) throw new AppError('PROFILE_ALREADY_EXISTS', 409)

  const age = calculateAge(data.dob)
  if (age < 18) throw new AppError('PROFILE_UNDERAGE', 400)

  return workerRepo.create(userId, data)
}
```

---

## Repositories — DB Queries Only

```ts
// repositories/worker.repo.ts
// Repo only: raw DB calls. No business rules, no validation.

export async function create(userId: string, data: CreateProfileData) {
  const result = await db('worker_profiles').insert({ user_id: userId, ...data }).returning('*')
  return result[0]
}

export async function findByUserId(userId: string) {
  return db('worker_profiles').where({ user_id: userId }).first()
}
```

