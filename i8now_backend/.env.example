NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/i8now
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-secret
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long-secret
OTP_PEPPER=change-me-otp-pepper
# Dev bootstrap: when this email verifies OTP, role becomes admin (also applied on server startup if the user already exists).
ADMIN_PROMOTE_EMAIL=admin@i8now.local
#
# Browser origins allowed for CORS (admin UI on another port). Comma-separated.
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
#
# Redis — used by BullMQ notification queue (defaults to localhost:6379)
# NOTIFICATIONS_QUEUE_ENABLED=false
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
#
# SMTP (Gmail example; for notifications email channel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-gmail@gmail.com
#
# Expo push (optional; recommended in production). Create in Expo dashboard → Access tokens.
# Used as Authorization: Bearer for https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN=
